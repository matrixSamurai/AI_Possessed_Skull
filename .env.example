APP_MODE=development
MOTION_BACKEND=simulation
CONVERSATION_BACKEND=mock
CAMERA_INDEX=0
CAMERA_FPS=20
FACE_MODEL_PATH=assets/face_landmarker.task
FACE_DETECTION_HOLD_SECONDS=0.3
FACE_FACING_HOLD_SECONDS=2.0
FACE_DROPOUT_SECONDS=0.25
FACE_YAW_THRESHOLD=25
FACE_PITCH_THRESHOLD=20
EYE_TRACKING_HZ=10
EYE_MAX_PAN_DEGREES=20
EYE_MAX_TILT_DEGREES=15
CONVERSATION_IDLE_TIMEOUT_SECONDS=30
# Active sessions survive temporary occlusion/movement; close after continuous absence.
VISITOR_ABSENCE_TIMEOUT_SECONDS=20
MAX_SESSION_DURATION_SECONDS=180
COOLDOWN_REARM_ABSENCE_SECONDS=5
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
SERIAL_PORT=
SERIAL_BAUDRATE=115200
DEBUG_MODE=false

# Speaker-safe mode sends silence while the ghost speaks; disables voice interruption.
# Set false with headphones to allow simultaneous speech / interruptions.
AUDIO_SUPPRESS_MIC_DURING_PLAYBACK=true
AUDIO_PLAYBACK_BUFFER_MS=120
AUDIO_PLAYBACK_MAX_WAIT_MS=250
AUDIO_INPUT_CHUNK_MS=100

# Opt-in: upload a fresh image at start and about every 6 seconds.
VISION_CONTEXT_ENABLED=false
VISION_CONTEXT_INTERVAL_SECONDS=6
VISION_CONTEXT_TIMEOUT_SECONDS=5
VISION_CONTEXT_MAX_IMAGE_SIDE=640
VISION_CONTEXT_DELIVERY_WAIT_SECONDS=15

# Local cached scary voices, triggered by a face or sustained scene motion.
AMBIENCE_ENABLED=false
AMBIENCE_DIRECTORY=assets/ambience
AMBIENCE_DURATION_SECONDS=25
AMBIENCE_VOLUME=0.15
AMBIENCE_DURING_CONVERSATION=false
AMBIENCE_TRIGGER_HOLD_SECONDS=0.3
AMBIENCE_REARM_SECONDS=3
AMBIENCE_COOLDOWN_SECONDS=10
MOTION_PIXEL_THRESHOLD=25
MOTION_AREA_THRESHOLD=0.015
