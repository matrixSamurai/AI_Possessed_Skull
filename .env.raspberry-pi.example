# Raspberry Pi 5, using local camera, microphone and speaker.
CAMERA_BACKEND=picamera2
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15
# ARM-friendly frontal face detection; no Face Landmarker download needed.
FACE_BACKEND=opencv
FACE_OPENCV_MAX_WIDTH=960
FACE_OPENCV_MIN_SIZE=24
FACE_OPENCV_MIN_NEIGHBORS=5
# Empty = operating system default. Use device name or numeric ID from malachi.devices.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_SUPPRESS_MIC_DURING_PLAYBACK=true
CONVERSATION_BACKEND=elevenlabs
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
VISION_CONTEXT_ENABLED=true
VISION_CONTEXT_INTERVAL_SECONDS=6
VISION_GREETING_ENABLED=true
VISITOR_ABSENCE_TIMEOUT_SECONDS=20
MAX_SESSION_DURATION_SECONDS=180
AMBIENCE_ENABLED=true
AMBIENCE_DIRECTORY=assets/ambience_library
AMBIENCE_FRESH_EFFECTS_ENABLED=false
AMBIENCE_DURING_CONVERSATION=true
AMBIENCE_VOLUME=0.15
# Physical servo/LED wiring is configured separately. Keep preview motion for now.
MOTION_BACKEND=simulation

# Preserve startup qualification through short face-detection gaps.
FACE_STARTUP_GRACE_SECONDS=1.25

# Local diagnostic archive; expires after 72 hours.
LOG_DIRECTORY=logs
LOG_RETENTION_DAYS=3
DIAGNOSTIC_CAPTURE_ENABLED=true
